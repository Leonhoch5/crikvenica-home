# SMTP configuration used by /api/contact
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SERVERNAME=
# Where inquiries should be delivered
CONTACT_TO=

# Email envelope sender (must be allowed by your SMTP provider)
CONTACT_FROM=

# Optional Strapi backend for villa content
STRAPI_URL=

# Optional bearer token for private Strapi reads
STRAPI_API_TOKEN=

# Google reCAPTCHA v3 — get keys at https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
